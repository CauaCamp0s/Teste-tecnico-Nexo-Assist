# SQLite local; produção: file:/data/nexo.db em volume persistente gravável.
DATABASE_URL="file:./dev.db"
# Chave do Google AI Studio, somente no servidor.
GOOGLE_GENERATIVE_AI_API_KEY=
# Modelo usado pelo Mastra.
LLM_MODEL=google/gemini-3.5-flash-lite
# Indisponibilidade única desde a primeira chamada do legado por processo; 0 desliga.
TICKET_SERVICE_OUTAGE_MS=0
# Limite de gerações (inclui novas tentativas) por sessão e por IP confiável.
AGENT_RATE_LIMIT_MAX=10
AGENT_RATE_LIMIT_WINDOW_MS=60000
# Em produção atrás de proxy que SOBRESCREVE x-forwarded-for, use true.
# false: limita por sessão; Next não fornece IP direto confiável nas actions.
TRUST_PROXY=false
# Porta do Next; npm start exige dependências de desenvolvimento para Prisma/tsx.
PORT=3000
