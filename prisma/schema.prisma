generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  ANALYST
}

enum ConversationStatus {
  AGENT
  WAITING_FOR_ANALYST
  ANALYST
  CLOSED
}

enum MessageRole {
  EMPLOYEE
  AGENT
  ANALYST
  SYSTEM
}

enum TicketType {
  INC
  REQ
}

enum TicketCategory {
  ACCESS
  NETWORK_VPN
  HARDWARE
  SOFTWARE
  EMAIL
  OTHER
}

enum TicketStatus {
  OPEN
  WAITING_FOR_ANALYST
  IN_PROGRESS
  APPROVED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketImpact {
  SELF
  TEAM
  COMPANY
}

enum TicketOperationKind {
  TRANSFER
  CREATE
  UPDATE
  REOPEN
}

enum TicketDraftKind {
  CREATE
  UPDATE
  REOPEN
}

enum TicketDraftStatus {
  PENDING
  CONFIRMED
  CANCELED
  FAILED
}

model User {
  id                    String            @id @default(cuid())
  email                 String            @unique
  name                  String
  role                  UserRole          @default(EMPLOYEE)
  createdAt             DateTime          @default(now())
  conversations         Conversation[]    @relation("EmployeeConversations")
  assignedConversations Conversation[]    @relation("AnalystConversations")
  messages              Message[]
  sessions              Session[]
  tickets               Ticket[]
  ticketDrafts          TicketDraft[]
  ticketOperations      TicketOperation[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id              String             @id @default(cuid())
  employeeId      String
  employee        User               @relation("EmployeeConversations", fields: [employeeId], references: [id], onDelete: Restrict)
  analystId       String?
  analyst         User?              @relation("AnalystConversations", fields: [analystId], references: [id], onDelete: Restrict)
  transferSummary String?
  status          ConversationStatus @default(AGENT)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  messages        Message[]
  ticketDrafts    TicketDraft[]

  @@index([employeeId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  role           MessageRole
  authorId       String?
  author         User?        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content        String
  decisionRecord Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt, id])
}

model Ticket {
  id              String            @id @default(cuid())
  number          String            @unique
  employeeId      String
  employee        User              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  type            TicketType
  category        TicketCategory
  status          TicketStatus      @default(OPEN)
  priority        TicketPriority
  impact          TicketImpact
  title           String
  description     String
  createdAt       DateTime          @default(now())
  lastUpdatedAt   DateTime?
  resolvedAt      DateTime?
  transferSummary String?
  operations      TicketOperation[]
  targetDrafts    TicketDraft[]     @relation("DraftTarget")
  confirmedDrafts TicketDraft[]     @relation("DraftResult")

  @@index([employeeId, status])
  @@index([employeeId, createdAt])
}

model TicketSequence {
  type  TicketType @id
  value Int
}

model TicketOperation {
  id             String              @id @default(cuid())
  employeeId     String
  employee       User                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  idempotencyKey String
  kind           TicketOperationKind
  payloadHash    String
  ticketId       String
  ticket         Ticket              @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  createdAt      DateTime            @default(now())

  @@unique([employeeId, idempotencyKey])
}

model TicketDraft {
  id             String            @id @default(cuid())
  employeeId     String
  employee       User              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  kind           TicketDraftKind
  targetTicketId String?
  targetTicket   Ticket?           @relation("DraftTarget", fields: [targetTicketId], references: [id], onDelete: Restrict)
  resultTicketId String?
  resultTicket   Ticket?           @relation("DraftResult", fields: [resultTicketId], references: [id], onDelete: Restrict)
  title          String
  description    String
  type           TicketType
  category       TicketCategory
  priority       TicketPriority
  impact         TicketImpact
  status         TicketDraftStatus @default(PENDING)
  failureCode    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([employeeId, conversationId, status])
}
